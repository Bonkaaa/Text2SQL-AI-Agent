# Application
APP_NAME=text2sql-agent
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# API Gateway
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# LLM Providers Configuration (openai | gemini | deepseek | mistral)
LLM_PROVIDER=openai

# 1. OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-key
OPENAI_TIER1_MODEL=gpt-4o
OPENAI_TIER2_MODEL=gpt-4o-mini

# 2. Google Gemini Configuration
GEMINI_API_KEY=your-gemini-key
GEMINI_TIER1_MODEL=gemini-1.5-pro
GEMINI_TIER2_MODEL=gemini-1.5-flash

# 3. DeepSeek Configuration
DEEPSEEK_API_KEY=your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_TIER1_MODEL=deepseek-reasoner
DEEPSEEK_TIER2_MODEL=deepseek-chat

# 4. Mistral AI Configuration
MISTRAL_API_KEY=your-mistral-key
MISTRAL_TIER1_MODEL=mistral-large-latest
MISTRAL_TIER2_MODEL=mistral-small-latest

# Global Tier Override (Tùy chọn: nếu để trống sẽ tự lấy theo provider được chọn)
# TIER1_MODEL=
# TIER2_MODEL=
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048

# Database & Warehouse
DUCKDB_PATH=./data/tpch.duckdb
BIGQUERY_PROJECT=
BIGQUERY_DATASET=

# Governance & Guardrails
DEFAULT_ROW_LIMIT=1000
MAX_RETRIES=3
MAX_BYTES_SCANNED=1073741824
QUERY_TIMEOUT_SECONDS=30

# LangSmith Tracing & Observability
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=text2sql-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
