# Application
APP_NAME=text2sql-agent
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# API Gateway
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# LLM Providers Configuration (openai | gemini | deepseek | mistral)
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-key
GEMINI_API_KEY=your-gemini-key
DEEPSEEK_API_KEY=your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
MISTRAL_API_KEY=your-mistral-key

# Model Tiering Strategy
TIER1_MODEL=gpt-4o
TIER2_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048

# Database & Warehouse
DUCKDB_PATH=./data/tpch.duckdb
BIGQUERY_PROJECT=
BIGQUERY_DATASET=

# Governance & Guardrails
DEFAULT_ROW_LIMIT=1000
MAX_RETRIES=3
MAX_BYTES_SCANNED=1073741824
QUERY_TIMEOUT_SECONDS=30
